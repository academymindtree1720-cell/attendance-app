# MongoDB Atlas connection string (required)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/attendance

# Session secret (required)
SESSION_SECRET=your-random-secret-here

# Google Sheets API (optional - for syncing data to Google Sheets)
GOOGLE_SHEET_ID=your-google-sheet-id-from-url
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour key here\n-----END PRIVATE KEY-----"
